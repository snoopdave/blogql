# Copy to .env (git-ignored) for local runs. On Render, set these in the dashboard.

# Claude API key for the workflow tasks.
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5
CLAUDE_MODEL=

# BlogQL GraphQL endpoint and the API key of the blog owner (BlogQL > Settings > API key).
BLOGQL_URL=https://blogql-server-cgpu.onrender.com/graphql
BLOGQL_API_KEY=
BLOGQL_BLOG_HANDLE=testblog

# Only for trigger.js (the cron job): a Render API key and the workflow's slug.
RENDER_API_KEY=
AUTOBLOG_WORKFLOW_SLUG=blogql-agent
